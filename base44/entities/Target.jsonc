{
  "name": "Target",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "חודש היעד, בפורמט YYYY-MM"
    },
    "revenue_target": {
      "type": "number",
      "description": "יעד הכנסות לחודש"
    },
    "deals_target": {
      "type": "number",
      "description": "יעד מספר עסקאות לחודש"
    }
  },
  "required": [
    "month",
    "revenue_target",
    "deals_target"
  ],
  "rls": {
    "create": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
